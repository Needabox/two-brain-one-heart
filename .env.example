# Optional Connection Mode override:
# auto (default: local-relay in dev, PeerJS Cloud in prod) | peerjs | local-relay | broadcast
VITE_SIGNALING_MODE=auto

# Optional custom PeerJS Server (defaults to public PeerJS Cloud 0.peerjs.com)
VITE_PEER_HOST=
VITE_PEER_PORT=
VITE_PEER_PATH=

# Optional JSON array of RTCIceServer objects (defaults to public Google & Cloudflare STUN servers).
# Add a TURN server entry here for reliable cellular / symmetric NAT traversal in production.
# Example:
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.example.com:3478","username":"u","credential":"p"}]
VITE_ICE_SERVERS=
